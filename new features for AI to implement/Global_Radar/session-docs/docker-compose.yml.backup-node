services:
  health-bridge:
    image: node:24-alpine
    container_name: health-bridge
    restart: unless-stopped
    
    working_dir: /app
    command: node bridge-service.js
    
    ports:
      - "8080:8080"
    
    volumes:
      - /srv/apps/source/health-agents:/app
      - /srv/apps/source/health-agents/findings:/app/findings
      - /srv/apps/source/health-agents/reports:/app/reports
    
    networks:
      - caddy_default
    
    env_file:
      - .env
    
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:8080/status"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

networks:
  caddy_default:
    external: true
