# changedetection.io Configuration Template
# Copy this to .env and customize
# FayaaLink Standard: All secrets and configuration in .env file

# Server Configuration
PORT=5000
LISTEN_HOST=0.0.0.0

# Logging
# Log levels: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
LOGGER_LEVEL=INFO

# Base URL (update this to match your domain)
BASE_URL=https://changedetection.fayaa92.sa

# Reverse proxy settings
# Enable this when behind Caddy reverse proxy
USE_X_SETTINGS=1

# Privacy and Security
HIDE_REFERER=true
DISABLE_VERSION_CHECK=false

# Performance
FETCH_WORKERS=10
MINIMUM_SECONDS_RECHECK_TIME=3

# Timezone (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Asia/Riyadh

# Locale
LC_ALL=en_US.UTF-8

# Screenshots
SCREENSHOT_MAX_HEIGHT=16000

# File URI access (disabled for security)
ALLOW_FILE_URI=false

# Browser/Playwright Support
# Playwright Chrome (for browser-steps and JavaScript-heavy sites)
# Enable this when playwright-chrome container is deployed
PLAYWRIGHT_DRIVER_URL=ws://playwright-chrome:3000

# WebDriver Support (Optional - alternative to Playwright)
# Uncomment if you deploy Selenium browser-chrome instead
# WEBDRIVER_URL=http://browser-chrome:4444/wd/hub

# Proxy Configuration (Optional)
# HTTP_PROXY=socks5h://proxy.example.com:1080
# HTTPS_PROXY=socks5h://proxy.example.com:1080
# NO_PROXY=localhost,192.168.0.0/24

# MCP Server (changedetection-mcp) Optional Overrides
# By default, the MCP server will use SALTED_PASS as API key if
# CHANGEDETECTION_API_KEY is not set.
CHANGEDETECTION_URL=http://changedetection:5000
# CHANGEDETECTION_API_KEY=<CHANGEDETECTION_API_KEY>
# CHANGEDETECTION_TIMEOUT=30
