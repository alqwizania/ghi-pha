# SehaRadar Environment Template
# Copy to .env and fill real values. Never commit .env.

# Server
SERVER_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info
TZ=Asia/Riyadh

# OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=SehaRadar

# ChangeDetection.io
CHANGEDETECTION_URL=http://changedetection:5000
CHANGEDETECTION_API_KEY=
CHANGEDETECTION_TIMEOUT=30
CHANGEDETECTION_WEBHOOK_TOKEN=

# SyncDetection (ChangeDetection webhook -> durable queue -> single-watch scan)
SYNCDETECTION_ENABLED=true
SYNCDETECTION_DB_PATH=/data/syncdetection/syncdetection.db
SYNCDETECTION_WORKER_CONCURRENCY=2
SYNCDETECTION_MAX_RETRIES=5
SYNCDETECTION_RETRY_BASE_SECONDS=15
SYNCDETECTION_RECONCILE_INTERVAL_SECONDS=300
SYNCDETECTION_POLL_INTERVAL_SECONDS=2
SYNCDETECTION_AUTO_SYNC_WEBHOOKS=false
SYNCDETECTION_REJECT_UNKNOWN_WATCH=false

# NocoDB
NOCODB_API_URL=http://nocodb:8080
NOCODB_BASE_ID=
NOCODB_API_TOKEN=
NOCODB_TABLE_ID=
NOCODB_QUARANTINE_TABLE_ID=mn6vcva5rqv1272

# RSSHub
RSSHUB_BASE_URL=http://rsshub:1200
RSSHUB_ACCESS_KEY=
RSSHUB_CACHE_EXPIRE=300
RSSHUB_REQUEST_TIMEOUT=30000

# Webhook Security
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Scheduling
PERIODIC_SCAN_ENABLED=true
GOOGLE_SCAN_HOUR=8
DIGEST_SCHEDULER_ENABLED=true
DIGEST_INTERVAL=daily
DIGEST_SCHEDULE_HOUR=19
DAILY_EMAIL_SCHEDULER_ENABLED=false
DAILY_EMAIL_SCHEDULE_HOUR=19
DAILY_EMAIL_INTERVAL=daily
REPORT_SCHEDULE_HOUR=19

# Google Search Optional
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_CX_ID=

# ProMED Optional
PROMED_EMAIL=
PROMED_PASSWORD=

# Tracing
TRACE_ENABLED=false
TRACE_LEVEL=standard
TRACE_TO_FILE=false
TRACE_FILE_PATH=/tmp/health-agents-trace.log

# Agent Runtime
RETRY_COUNT=3
SQLITE_PATH=/tmp/agents_sessions.db

# Email Notifications Optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Twilio / WhatsApp Optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
ALERT_PHONE_NUMBER=
